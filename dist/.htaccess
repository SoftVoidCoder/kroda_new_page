Options -Indexes
RewriteEngine On

RewriteRule ^api/lead$ api/lead.php [L]
RewriteRule ^api/questionnaire$ api/questionnaire.php [L]

<Files "common.php">
  Require all denied
</Files>

<IfModule mod_setenvif.c>
  SetEnvIf Host "\.tw1\.(ru|su)$" TECHNICAL_HOST
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Robots-Tag "noindex, nofollow" env=TECHNICAL_HOST
</IfModule>
